---
const categories = [
  {
    name: "Chat",
    channels: [
      { name: "Telegram", letter: "T", color: "group-hover:text-sky-400" },
      { name: "Discord", letter: "D", color: "group-hover:text-indigo-400" },
      { name: "Slack", letter: "S", color: "group-hover:text-purple-400" },
      { name: "WhatsApp", letter: "W", color: "group-hover:text-green-400" },
      { name: "Signal", letter: "Si", color: "group-hover:text-blue-400" },
    ],
  },
  {
    name: "Productivity",
    channels: [
      { name: "Email", letter: "E", color: "group-hover:text-violet-400" },
      { name: "GitHub", letter: "G", color: "group-hover:text-gray-300" },
      { name: "MQTT", letter: "Mq", color: "group-hover:text-amber-400" },
    ],
  },
  {
    name: "Custom",
    channels: [
      { name: "REST API", letter: "R", color: "group-hover:text-green-400" },
      { name: "Internal Chat", letter: "Ic", color: "group-hover:text-wire-400" },
      { name: "Webhooks", letter: "Wh", color: "group-hover:text-claw-400" },
    ],
  },
];
---

<section id="channels" class="relative py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-wire-500/[0.02] to-transparent"></div>
  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Channels
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        One agent. Every channel<br class="hidden sm:block" /> that matters.
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Native integrations, not API wrappers. Your agent receives messages, responds, and acts &mdash; wherever the conversation happens.
      </p>
    </div>

    <!-- Channel grid by category -->
    <div class="space-y-10 mb-16">
      {categories.map((cat, ci) => (
        <div data-animate data-delay={String(Math.min(ci + 1, 3))}>
          <div class="text-xs font-mono text-text-muted uppercase tracking-widest mb-4 pl-1">
            {cat.name}
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-3">
            {cat.channels.map((ch) => (
              <div class="group flex items-center gap-3 px-4 py-3 rounded-xl border border-white/5 bg-surface-raised/30 hover:bg-surface-raised hover:border-wire-500/20 transition-all duration-200 cursor-default">
                <div class={`w-8 h-8 rounded-lg bg-white/5 group-hover:bg-wire-500/10 flex items-center justify-center text-xs font-mono font-bold text-text-muted ${ch.color} transition-colors`}>
                  {ch.letter}
                </div>
                <span class="text-sm text-text-secondary group-hover:text-text-primary transition-colors truncate">
                  {ch.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Code callout -->
    <div class="max-w-2xl mx-auto text-center" data-animate data-delay="2">
      <div class="inline-block rounded-xl border border-white/5 bg-surface p-5 glow-wire">
        <div class="font-mono text-sm text-text-muted mb-3">Add a channel with one line in your config</div>
        <div class="font-mono text-sm">
          <span class="text-wire-400">channels</span>
          <span class="text-text-muted"> = </span>
          <span class="text-text-muted">[</span>
          <span class="text-claw-400">"telegram"</span>
          <span class="text-text-muted">, </span>
          <span class="text-claw-400">"discord"</span>
          <span class="text-text-muted">, </span>
          <span class="text-claw-400">"slack"</span>
          <span class="text-text-muted">, </span>
          <span class="text-claw-400">"email"</span>
          <span class="text-text-muted">]</span>
        </div>
      </div>
    </div>
  </div>
</section>
