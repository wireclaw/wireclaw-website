---
const links = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how-it-works" },
  { label: "Architecture", href: "#architecture" },
  { label: "Pricing", href: "#pricing" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-xl bg-navy-950/70"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="relative w-8 h-8 flex items-center justify-center">
        <svg viewBox="0 0 32 32" class="w-8 h-8" fill="none">
          <path
            d="M16 2L4 9v14l12 7 12-7V9L16 2z"
            stroke="currentColor"
            stroke-width="1.5"
            class="text-wire-500"
          />
          <path
            d="M16 2v28M4 9l12 7 12-7M4 23l12-7 12 7"
            stroke="currentColor"
            stroke-width="1"
            class="text-wire-500/50"
          />
          <circle cx="16" cy="16" r="3" class="fill-wire-500" opacity="0.8" />
        </svg>
      </div>
      <span class="font-display font-bold text-lg tracking-tight">
        wire<span class="text-wire-500">claw</span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href="#pricing"
        class="hidden sm:inline-flex text-sm text-text-secondary hover:text-text-primary transition-colors"
      >
        Sign in
      </a>
      <a
        href="#pricing"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-wire-500 text-white hover:bg-wire-600 transition-all duration-200 shadow-[0_0_20px_rgba(59,130,246,0.2)]"
      >
        Get started
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</nav>
