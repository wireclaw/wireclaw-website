---
const links = [
  { label: "Features", href: "/#features" },
  { label: "Channels", href: "/#channels" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Docs", href: "/docs" },
  { label: "Blog", href: "/blog" },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent backdrop-blur-xl transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="relative w-8 h-8 flex items-center justify-center">
        <svg viewBox="0 0 32 32" class="w-8 h-8" fill="none">
          <path
            d="M16 2L4 9v14l12 7 12-7V9L16 2z"
            stroke="currentColor"
            stroke-width="1.5"
            class="text-wire-500"
          />
          <path
            d="M16 2v28M4 9l12 7 12-7M4 23l12-7 12 7"
            stroke="currentColor"
            stroke-width="1"
            class="text-wire-500/50"
          />
          <circle cx="16" cy="16" r="3" class="fill-wire-500" opacity="0.8" />
        </svg>
      </div>
      <span class="font-display font-bold text-lg tracking-tight">
        wire<span class="text-wire-500">claw</span>
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://app.wireclaw.ai"
        class="hidden sm:inline-flex text-sm text-text-secondary hover:text-text-primary transition-colors"
      >
        Sign in
      </a>
      <a
        href="https://app.wireclaw.ai"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-wire-500 text-white hover:bg-wire-600 transition-all duration-200 shadow-[0_0_20px_rgba(59,130,246,0.2)]"
      >
        Get started
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-text-secondary hover:text-text-primary hover:bg-white/5 transition-colors"
        aria-label="Open menu"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/5 bg-navy-950/95 backdrop-blur-xl"
  >
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {links.map((link) => (
        <a
          href={link.href}
          class="mobile-link text-base text-text-secondary hover:text-text-primary transition-colors py-2"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 border-t border-white/5 flex flex-col gap-3">
        <a href="https://app.wireclaw.ai" class="text-sm text-text-secondary hover:text-text-primary transition-colors py-2">
          Sign in
        </a>
        <a
          href="https://app.wireclaw.ai"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-medium rounded-lg bg-wire-500 text-white hover:bg-wire-600 transition-all"
        >
          Get started
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Scroll-based navbar background
  const nav = document.getElementById("main-nav");
  function updateNav() {
    if (window.scrollY > 80) {
      nav?.classList.add("bg-navy-950/80", "border-white/5");
      nav?.classList.remove("border-transparent");
    } else {
      nav?.classList.remove("bg-navy-950/80", "border-white/5");
      nav?.classList.add("border-transparent");
    }
  }
  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const hamburger = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    hamburger?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Close menu on link click
  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      hamburger?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
