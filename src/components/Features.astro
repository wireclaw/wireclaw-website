---
const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
    title: "Multi-channel",
    description:
      "Deploy agents to Telegram, Discord, Slack, and custom webhooks. One agent, every conversation.",
    tag: "Channels",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z"/><path d="M9 12h6M12 9v6"/></svg>`,
    title: "Persistent memory",
    description:
      "SQLite and Markdown memory survives restarts. Agents remember context across sessions and deploys.",
    tag: "Memory",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Autonomous tools",
    description:
      "Browser automation, shell execution, web search, HTTP requests, file I/O \u2014 agents act on their own.",
    tag: "Tools",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
    title: "MCP servers",
    description:
      "Extend agent capabilities with Model Context Protocol servers. Playwright, databases, custom APIs.",
    tag: "Protocol",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
    title: "Model agnostic",
    description:
      "Claude, GPT, Gemini, Llama \u2014 any model via Sulaert router. Switch providers without code changes.",
    tag: "Models",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "Zero-downtime deploys",
    description:
      "Workspace dehydration to S3, warm pod pool, session handoff. Redeploy without dropping a message.",
    tag: "Ops",
  },
];
---

<section id="features" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Capabilities
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        Everything agents need
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        A complete runtime for autonomous AI agents with production-grade infrastructure.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature, i) => (
        <div
          class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire"
          data-animate
          data-delay={String((i % 3) + 1)}
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
              <Fragment set:html={feature.icon} />
            </div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
              {feature.tag}
            </span>
          </div>
          <h3 class="font-display font-semibold text-lg mb-2.5">{feature.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
