---
---

<section id="features" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Platform
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        Managed agents that actually work
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Configure once. We handle the rest &mdash; hosting, scaling, uptime.
      </p>
    </div>

    <!-- Bento grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

      <!-- 1. Multi-channel (large — spans 2 cols) -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire lg:col-span-2"
        data-animate
        data-delay="1"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Channels
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Every channel that matters</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Your agent lives on Telegram, Discord, Slack, WhatsApp, Email, and more. Connect a channel in minutes &mdash; we handle the webhooks.
        </p>
        <div class="flex flex-wrap gap-3">
          {[
            { name: "Telegram", letter: "T", color: "text-sky-400" },
            { name: "Discord", letter: "D", color: "text-indigo-400" },
            { name: "Slack", letter: "S", color: "text-purple-400" },
            { name: "WhatsApp", letter: "W", color: "text-green-400" },
            { name: "Signal", letter: "Si", color: "text-blue-400" },
            { name: "Email", letter: "E", color: "text-violet-400" },
            { name: "GitHub", letter: "G", color: "text-gray-400" },
            { name: "MQTT", letter: "Mq", color: "text-amber-400" },
          ].map((ch) => (
            <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/5 text-xs font-mono">
              <span class={`font-semibold ${ch.color}`}>{ch.letter}</span>
              <span class="text-text-muted">{ch.name}</span>
            </div>
          ))}
          <div class="flex items-center px-2.5 py-1.5 rounded-lg bg-white/[0.03] border border-white/5 text-xs font-mono text-text-muted">
            +3 more
          </div>
        </div>
      </div>

      <!-- 2. Persistent memory -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire"
        data-animate
        data-delay="2"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z"/><path d="M9 12h6M12 9v6"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Memory
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Agents that remember everything</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Your agent remembers every conversation, every decision, every context. Memory persists across sessions &mdash; it never forgets.
        </p>
        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="px-2.5 py-1.5 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400">Conversations</span>
          <span class="text-text-muted">+</span>
          <span class="px-2.5 py-1.5 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400">Decisions</span>
          <span class="text-text-muted">+</span>
          <span class="px-2.5 py-1.5 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400">Files</span>
        </div>
      </div>

      <!-- 3. Autonomous tools -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire"
        data-animate
        data-delay="1"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Tools
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Agents that act, not just chat</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Browse the web, run code, search the internet, manage files, call APIs &mdash; your agent does the work, not just the talking.
        </p>
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          {["browser", "shell", "web_search", "http", "file_io", "memory"].map((tool) => (
            <span class="px-2.5 py-1.5 rounded-lg bg-claw-500/10 border border-claw-500/15 text-claw-400">
              {tool}
            </span>
          ))}
        </div>
      </div>

      <!-- 4. MCP servers -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire"
        data-animate
        data-delay="2"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Extensible
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Extend with any tool</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Connect any tool via Model Context Protocol. Databases, APIs, Playwright &mdash; your agent uses them as native capabilities.
        </p>
        <div class="rounded-lg bg-surface border border-white/5 p-3 font-mono text-xs text-text-muted overflow-x-auto">
          <span class="text-wire-400">mcp_servers</span> = [<span class="text-claw-400">"playwright"</span>, <span class="text-claw-400">"postgres"</span>, <span class="text-claw-400">"custom-api"</span>]
        </div>
      </div>

      <!-- 5. Model agnostic -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire"
        data-animate
        data-delay="3"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 group-hover:bg-wire-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Models
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Any model, one switch</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Claude, GPT, Gemini, Llama &mdash; pick the best model for the job. Switch anytime, no code changes.
        </p>
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          {[
            { name: "Claude", color: "text-violet-400 bg-violet-500/10 border-violet-500/15" },
            { name: "GPT", color: "text-green-400 bg-green-500/10 border-green-500/15" },
            { name: "Gemini", color: "text-blue-400 bg-blue-500/10 border-blue-500/15" },
            { name: "Llama", color: "text-purple-400 bg-purple-500/10 border-purple-500/15" },
          ].map((model) => (
            <span class={`px-2.5 py-1.5 rounded-lg border ${model.color}`}>
              {model.name}
            </span>
          ))}
        </div>
      </div>

      <!-- 6. Wake-on-demand efficiency (spans 2 cols) -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire lg:col-span-2"
        data-animate
        data-delay="1"
      >
        <div class="flex items-start justify-between mb-5">
          <div class="w-11 h-11 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-green-400 group-hover:bg-green-500/15 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-text-muted border border-white/5 rounded-full px-2.5 py-1">
            Efficiency
          </span>
        </div>
        <h3 class="font-display font-semibold text-lg mb-2.5">Agents are free. You pay when they work.</h3>
        <p class="text-sm text-text-secondary leading-relaxed mb-5">
          Deploy 10 agents or 100 &mdash; idle agents cost nothing. They wake on demand, do the job, and go back to sleep. You only pay for tokens used.
        </p>
        <div class="flex flex-wrap gap-3 text-xs font-mono">
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-green-500/10 border border-green-500/15 text-green-400">
            <span class="font-semibold">$0</span>
            <span class="text-green-400/70">per agent</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-green-500/10 border border-green-500/15 text-green-400">
            <span class="font-semibold">$0</span>
            <span class="text-green-400/70">when idle</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400">
            <span class="font-semibold">tokens</span>
            <span class="text-wire-400/70">only when working</span>
          </div>
        </div>
      </div>

      <!-- 7. Pay as you go (wide — spans 3 cols) -->
      <div
        class="group relative rounded-2xl border border-white/5 bg-surface-raised/50 hover:bg-surface-raised p-7 transition-all duration-300 hover:border-wire-500/20 hover:glow-wire lg:col-span-3 md:col-span-2"
        data-animate
        data-delay="1"
      >
        <div class="flex flex-col sm:flex-row sm:items-start gap-6">
          <div class="shrink-0">
            <div class="flex items-start justify-between mb-5">
              <div class="w-11 h-11 rounded-xl bg-claw-500/10 border border-claw-500/20 flex items-center justify-center text-claw-400 group-hover:bg-claw-500/15 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>
              </div>
            </div>
            <h3 class="font-display font-semibold text-lg mb-2.5">No per-agent fees. Ever.</h3>
            <p class="text-sm text-text-secondary leading-relaxed max-w-md">
              Deploy as many agents as you want &mdash; agents are free. No minimum spend, no commitments. Scale as you go.
            </p>
          </div>
          <div class="flex items-center gap-3 text-xs font-mono sm:mt-8 flex-wrap sm:flex-nowrap">
            <span class="px-3 py-2 rounded-lg bg-green-500/10 border border-green-500/15 text-green-400 whitespace-nowrap">Free to start</span>
            <svg class="w-4 h-4 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M13 7l5 5-5 5"/></svg>
            <span class="px-3 py-2 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400 whitespace-nowrap">Use what you need</span>
            <svg class="w-4 h-4 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M13 7l5 5-5 5"/></svg>
            <span class="px-3 py-2 rounded-lg bg-wire-500/10 border border-wire-500/15 text-wire-400 whitespace-nowrap">Top up anytime</span>
            <svg class="w-4 h-4 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M13 7l5 5-5 5"/></svg>
            <span class="px-3 py-2 rounded-lg bg-claw-500/10 border border-claw-500/15 text-claw-400 whitespace-nowrap">No monthly fees</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
