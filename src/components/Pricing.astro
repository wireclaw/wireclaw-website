---
const plans = [
  {
    name: "Starter",
    price: "Free",
    period: "",
    description: "For experimentation and personal projects",
    features: [
      "1 agent instance",
      "2 channels",
      "Community models via Sulaert",
      "1 GB workspace storage",
      "Basic memory (Markdown)",
      "Community support",
    ],
    cta: "Start free",
    highlighted: false,
  },
  {
    name: "Pro",
    price: "$49",
    period: "/month",
    description: "For teams building production agents",
    features: [
      "10 agent instances",
      "Unlimited channels",
      "All models via Sulaert",
      "25 GB workspace storage",
      "Full memory (SQLite + Markdown)",
      "Custom MCP servers",
      "Priority support",
      "Webhook integrations",
    ],
    cta: "Start 14-day trial",
    highlighted: true,
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "",
    description: "For organizations with custom requirements",
    features: [
      "Unlimited agents",
      "Unlimited channels",
      "Bring your own API keys",
      "Unlimited storage",
      "Dedicated infrastructure",
      "Custom MCP servers",
      "SSO & RBAC",
      "SLA & dedicated support",
    ],
    cta: "Contact sales",
    highlighted: false,
  },
];
---

<section id="pricing" class="relative py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-wire-500/[0.02] to-transparent"></div>
  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-20" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Pricing
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        Start free, scale infinitely
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        No credit card required. Upgrade when your agents are ready for production.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {plans.map((plan, i) => (
        <div
          class={`relative rounded-2xl p-8 transition-all duration-300 ${
            plan.highlighted
              ? "border-2 border-wire-500/40 bg-surface-raised glow-wire-strong scale-[1.02]"
              : "border border-white/5 bg-surface-raised/50 hover:border-white/10"
          }`}
          data-animate
          data-delay={String(i + 1)}
        >
          {plan.highlighted && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-wire-500 text-white text-xs font-semibold">
              Most popular
            </div>
          )}

          <div class="mb-8">
            <h3 class="font-display font-semibold text-lg mb-1">{plan.name}</h3>
            <p class="text-sm text-text-muted mb-5">{plan.description}</p>
            <div class="flex items-baseline gap-1">
              <span class="font-display font-bold text-4xl">{plan.price}</span>
              {plan.period && <span class="text-text-muted text-sm">{plan.period}</span>}
            </div>
          </div>

          <ul class="space-y-3 mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <svg class="w-4 h-4 mt-0.5 text-wire-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href="#"
            class={`block w-full text-center py-3 px-6 rounded-xl text-sm font-semibold transition-all duration-300 ${
              plan.highlighted
                ? "bg-wire-500 text-white hover:bg-wire-600 shadow-[0_0_25px_rgba(59,130,246,0.25)]"
                : "border border-white/10 text-text-secondary hover:text-text-primary hover:border-white/20 hover:bg-white/5"
            }`}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
