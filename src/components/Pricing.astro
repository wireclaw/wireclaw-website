---
const howItWorks = [
  {
    step: "1",
    title: "Sign up free",
    description: "Create your first agent for free. No credit card needed.",
  },
  {
    step: "2",
    title: "Create agents",
    description: "Configure as many agents as you want. You only pay when they run.",
  },
  {
    step: "3",
    title: "Top up when needed",
    description: "Add balance anytime — $10, $25, $50, $100, or any custom amount.",
  },
];

const included = [
  "Unlimited agents",
  "Unlimited channels",
  "All models (Claude, GPT, Gemini, DeepSeek, Llama, Mistral, Grok)",
  "All tools (browser, shell, search, MCP)",
  "Persistent memory",
  "Custom MCP servers",
  "API access",
  "Daily and monthly cost limits",
];

const faqs = [
  {
    q: "What do I pay for?",
    a: "You pay for the compute your agents use — LLM tokens and tool execution. Channel connections and agent configuration are free. You see the cost of each model upfront before choosing it.",
  },
  {
    q: "Are there any per-agent fees?",
    a: "None. Agents are free to create and deploy. You pay only for tokens when they work. Optional add-ons like persistent memory are available separately.",
  },
  {
    q: "Can I set spending limits?",
    a: "Yes. Set daily and monthly cost limits per agent. Your agent pauses when it hits the limit — no surprise bills.",
  },
  {
    q: "Can I bring my own API keys?",
    a: "Contact us for enterprise arrangements with custom API key routing. For most users, all model access is included through the platform.",
  },
  {
    q: "What happens when my balance runs out?",
    a: "Your agents pause gracefully. No data is lost — memory and configuration persist. Top up to resume instantly.",
  },
];
---

<section id="pricing" class="relative py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-wire-500/[0.02] to-transparent"></div>
  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Pricing
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        No per-agent fees. Pay as you go.
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Every feature included. You only pay for what your agents use.
      </p>
    </div>

    <!-- Main pricing card -->
    <div class="max-w-3xl mx-auto mb-16" data-animate data-delay="1">
      <div class="relative rounded-2xl border-2 border-wire-500/40 bg-surface-raised p-10 glow-wire-strong">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-wire-500 text-white text-xs font-semibold">
          Everything included
        </div>

        <div class="text-center mb-8">
          <div class="flex items-baseline justify-center gap-2 mb-2">
            <span class="font-display font-bold text-5xl text-gradient-wire">$0</span>
            <span class="text-text-muted text-lg">/month</span>
          </div>
          <p class="text-text-secondary">
            Pay only for compute. <span class="text-green-400 font-semibold">Start free</span> &mdash; no credit card needed.
          </p>
        </div>

        <!-- Included features grid -->
        <div class="grid sm:grid-cols-2 gap-3 mb-8">
          {included.map((feature) => (
            <div class="flex items-center gap-3 text-sm text-text-secondary">
              <svg class="w-4 h-4 text-wire-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {feature}
            </div>
          ))}
        </div>

        <a
          href="https://app.wireclaw.ai"
          class="block w-full text-center py-3.5 px-6 rounded-xl text-sm font-semibold bg-wire-500 text-white hover:bg-wire-600 transition-all duration-300 shadow-[0_0_25px_rgba(59,130,246,0.25)]"
        >
          Get started free
        </a>
      </div>
    </div>

    <!-- How it works steps -->
    <div class="max-w-3xl mx-auto mb-20">
      <h3 class="font-display font-semibold text-xl text-center mb-8" data-animate>How it works</h3>
      <div class="grid sm:grid-cols-3 gap-6">
        {howItWorks.map((item, i) => (
          <div class="text-center" data-animate data-delay={String(i + 1)}>
            <div class="w-10 h-10 rounded-xl bg-wire-500/10 border border-wire-500/20 flex items-center justify-center text-wire-400 font-display font-bold text-sm mx-auto mb-4">
              {item.step}
            </div>
            <h4 class="font-display font-semibold text-sm mb-2">{item.title}</h4>
            <p class="text-xs text-text-muted leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-3xl mx-auto" data-animate>
      <h3 class="font-display font-semibold text-xl text-center mb-8">Questions</h3>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-white/5 bg-surface-raised/50 overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer text-sm font-medium text-text-primary hover:text-wire-400 transition-colors list-none">
              {faq.q}
              <svg class="w-4 h-4 text-text-muted transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-text-secondary leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
