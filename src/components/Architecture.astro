---
const layers = [
  {
    label: "Channels",
    items: ["Telegram", "Discord", "Slack", "Webhooks"],
    color: "wire",
  },
  {
    label: "Ingestion",
    items: ["IEG \u2014 Event Gateway", "Rate Limiting", "Tenant Resolution"],
    color: "wire",
  },
  {
    label: "Orchestration",
    items: ["Gate \u2014 API Gateway", "Config Builder", "S3 Workspace", "Redis Sessions"],
    color: "wire",
  },
  {
    label: "Runtime",
    items: ["Sidecar \u2014 Pod Manager", "Hydration / Dehydration", "Process Lifecycle"],
    color: "claw",
  },
  {
    label: "Agent",
    items: ["RayCore \u2014 Agent Loop", "Tool Execution", "Memory (SQLite)", "Sulaert Router"],
    color: "claw",
  },
];
---

<section id="architecture" class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20" data-animate>
      <span class="inline-block text-xs font-mono text-wire-400 tracking-widest uppercase mb-4">
        Platform
      </span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
        Built for production
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Five layers from channel message to autonomous agent action.
        Every component is stateless, observable, and independently scalable.
      </p>
    </div>

    <div class="max-w-4xl mx-auto" data-animate data-delay="2">
      <div class="relative space-y-3">
        {layers.map((layer, i) => (
          <div class="relative group">
            <!-- Connector line -->
            {i < layers.length - 1 && (
              <div class="absolute left-1/2 -bottom-3 w-px h-3 bg-gradient-to-b from-white/10 to-transparent z-10"></div>
            )}

            <div class="grid grid-cols-[120px_1fr] sm:grid-cols-[160px_1fr] gap-4 items-center">
              <!-- Layer label -->
              <div class="text-right">
                <span class="text-xs font-mono text-text-muted uppercase tracking-wider">
                  {layer.label}
                </span>
                <div class={`h-px mt-2 bg-gradient-to-l from-${layer.color === "claw" ? "claw-500/30" : "wire-500/30"} to-transparent`}></div>
              </div>

              <!-- Layer content -->
              <div
                class={`flex flex-wrap gap-2 p-4 rounded-xl border transition-all duration-300 ${
                  layer.color === "claw"
                    ? "border-claw-500/10 bg-claw-500/[0.03] hover:border-claw-500/20"
                    : "border-wire-500/10 bg-wire-500/[0.03] hover:border-wire-500/20"
                }`}
              >
                {layer.items.map((item) => (
                  <span
                    class={`inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-mono ${
                      layer.color === "claw"
                        ? "bg-claw-500/10 text-claw-400 border border-claw-500/15"
                        : "bg-wire-500/10 text-wire-400 border border-wire-500/15"
                    }`}
                  >
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Flow arrows -->
      <div class="mt-12 flex items-center justify-center gap-6 text-text-muted text-xs font-mono" data-animate data-delay="3">
        <span>Message in</span>
        <svg class="w-4 h-4 text-wire-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Route</span>
        <svg class="w-4 h-4 text-wire-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Wake</span>
        <svg class="w-4 h-4 text-claw-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Hydrate</span>
        <svg class="w-4 h-4 text-claw-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        <span>Act</span>
      </div>
    </div>
  </div>
</section>
