---
---

<section class="relative py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div
      class="relative rounded-3xl border border-wire-500/20 bg-gradient-to-br from-wire-500/[0.06] to-transparent p-12 sm:p-16 text-center overflow-hidden glow-wire"
      data-animate
    >
      <div class="absolute inset-0 bg-grid opacity-50"></div>

      <div class="relative z-10">
        <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight mb-5">
          Your agents should be
          <br />
          <span class="text-gradient-wire">running right now</span>
        </h2>
        <p class="text-text-secondary text-lg max-w-xl mx-auto mb-10">
          Create your first agent in under five minutes.
          Free to start, no credit card, no per-agent fees.
        </p>

        <a
          href="#pricing"
          class="group inline-flex items-center gap-2.5 px-8 py-4 text-base font-semibold rounded-xl bg-wire-500 text-white hover:bg-wire-600 transition-all duration-300 animate-pulse-cta"
        >
          Get started free
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
