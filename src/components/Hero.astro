---
const terminalLines = [
  { prompt: true, text: "wireclaw deploy --agent research-bot" },
  { prompt: false, text: "  Building workspace..." },
  { prompt: false, text: '  Model: claude-sonnet-4-5 via sulaert' },
  { prompt: false, text: "  Tools: browser, shell, web_search, mcp" },
  { prompt: false, text: "  Channels: telegram, discord" },
  { prompt: false, text: '  Memory: persistent (SQLite + Markdown)' },
  { prompt: false, text: "" },
  { prompt: false, text: "  \u2713 Workspace uploaded to S3" },
  { prompt: false, text: "  \u2713 Agent pod claimed session" },
  { prompt: false, text: "  \u2713 Agent running \u2014 listening on 2 channels" },
  { prompt: false, text: "" },
  { prompt: true, text: "wireclaw status research-bot" },
  { prompt: false, text: "  Status: active | Uptime: 47h | Messages: 1,284" },
];
---

<section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-grid"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-navy-950 via-transparent to-navy-950"></div>
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] rounded-full opacity-20 blur-[120px]"
    style="background: radial-gradient(circle, rgba(59,130,246,0.3), transparent 70%)"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-2 gap-16 items-center">
    <!-- Left: Copy -->
    <div>
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-wire-500/20 bg-wire-500/5 text-wire-400 text-xs font-mono mb-8"
        style="animation: fade-in-up 0.6s cubic-bezier(0.16,1,0.3,1) both"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-wire-500 animate-pulse"></span>
        v2.0 &mdash; Now with MCP server support
      </div>

      <h1
        class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl leading-[0.95] tracking-tight mb-6"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.1s both"
      >
        Deploy autonomous
        <br />
        <span class="text-gradient-wire">AI agents</span>
        <br />
        in minutes
      </h1>

      <p
        class="text-lg text-text-secondary max-w-lg leading-relaxed mb-10"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.2s both"
      >
        Orchestrate long-running AI agents across Telegram, Discord, and Slack.
        Persistent memory, autonomous tool execution, zero-downtime deploys.
      </p>

      <div
        class="flex flex-wrap gap-4"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.3s both"
      >
        <a
          href="#pricing"
          class="group inline-flex items-center gap-2.5 px-6 py-3 text-sm font-semibold rounded-xl bg-wire-500 text-white hover:bg-wire-600 transition-all duration-300 shadow-[0_0_30px_rgba(59,130,246,0.25)] hover:shadow-[0_0_40px_rgba(59,130,246,0.4)]"
        >
          Get started free
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="#architecture"
          class="inline-flex items-center gap-2.5 px-6 py-3 text-sm font-medium rounded-xl border border-white/10 text-text-secondary hover:text-text-primary hover:border-white/20 hover:bg-white/5 transition-all duration-300"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Documentation
        </a>
      </div>
    </div>

    <!-- Right: Terminal -->
    <div
      class="relative"
      style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.4s both"
    >
      <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-wire-500/20 to-transparent"></div>
      <div class="relative rounded-2xl bg-surface border border-white/5 overflow-hidden glow-wire">
        <!-- Terminal titlebar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-surface-raised">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
          </div>
          <span class="ml-2 text-xs text-text-muted font-mono">terminal &mdash; wireclaw</span>
        </div>

        <!-- Terminal body -->
        <div class="p-5 font-mono text-[13px] leading-6 min-h-[340px] relative overflow-hidden scanline">
          <div id="terminal-output" class="space-y-0">
            {terminalLines.map((line, i) => (
              <div
                class="terminal-line opacity-0"
                style={`animation: fade-in-up 0.4s cubic-bezier(0.16,1,0.3,1) ${0.8 + i * 0.15}s both`}
              >
                {line.prompt ? (
                  <span>
                    <span class="text-wire-400">$</span>{" "}
                    <span class="text-text-primary">{line.text}</span>
                  </span>
                ) : line.text.includes("\u2713") ? (
                  <span class="text-green-400">{line.text}</span>
                ) : (
                  <span class="text-text-muted">{line.text}</span>
                )}
              </div>
            ))}
          </div>
          <div
            class="mt-1 opacity-0"
            style="animation: fade-in-up 0.4s cubic-bezier(0.16,1,0.3,1) 3.6s both"
          >
            <span class="text-wire-400">$</span>
            <span class="inline-block w-2 h-4 ml-1.5 bg-wire-500 animate-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
