---
---

<section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-grid"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-navy-950 via-transparent to-navy-950"></div>
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] rounded-full opacity-20 blur-[120px]"
    style="background: radial-gradient(circle, rgba(59,130,246,0.3), transparent 70%)"
  ></div>

  <!-- Subtle rotating hexagonal wireframe -->
  <div class="absolute right-[5%] top-1/2 -translate-y-1/2 w-[500px] h-[500px] opacity-[0.04] animate-rotate-slow pointer-events-none hidden lg:block">
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full">
      <polygon points="100,10 178,55 178,145 100,190 22,145 22,55" stroke="currentColor" stroke-width="0.5" class="text-wire-500" />
      <polygon points="100,30 162,63 162,137 100,170 38,137 38,63" stroke="currentColor" stroke-width="0.3" class="text-wire-500" />
      <polygon points="100,50 146,71 146,129 100,150 54,129 54,71" stroke="currentColor" stroke-width="0.3" class="text-wire-500" />
      <line x1="100" y1="10" x2="100" y2="190" stroke="currentColor" stroke-width="0.2" class="text-wire-500" />
      <line x1="22" y1="55" x2="178" y2="145" stroke="currentColor" stroke-width="0.2" class="text-wire-500" />
      <line x1="178" y1="55" x2="22" y2="145" stroke="currentColor" stroke-width="0.2" class="text-wire-500" />
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-2 gap-16 items-center">
    <!-- Left: Copy -->
    <div>
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-wire-500/20 bg-wire-500/5 text-wire-400 text-xs font-mono mb-8"
        style="animation: fade-in-up 0.6s cubic-bezier(0.16,1,0.3,1) both"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-wire-500 animate-pulse"></span>
        30+ channels &middot; Any model &middot; Pay as you go
      </div>

      <h1
        class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl leading-[0.95] tracking-tight mb-6"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.1s both"
      >
        AI agents that
        <br />
        <span class="text-gradient-wire">live where your</span>
        <br />
        <span class="text-gradient-wire">users are</span>
      </h1>

      <p
        class="text-lg text-text-secondary max-w-lg leading-relaxed mb-10"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.2s both"
      >
        Autonomous AI agents across Telegram, Discord, Slack, and 30+ channels.
        Persistent memory, autonomous tools, any model. No subscriptions &mdash; pay only for what you use.
      </p>

      <div
        class="flex flex-wrap gap-4 items-center"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.3s both"
      >
        <a
          href="#pricing"
          class="group inline-flex items-center gap-2.5 px-6 py-3 text-sm font-semibold rounded-xl bg-wire-500 text-white hover:bg-wire-600 transition-all duration-300 shadow-[0_0_30px_rgba(59,130,246,0.25)] hover:shadow-[0_0_40px_rgba(59,130,246,0.4)]"
        >
          Get started free
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="#demo"
          class="inline-flex items-center gap-2.5 px-6 py-3 text-sm font-medium rounded-xl border border-white/10 text-text-secondary hover:text-text-primary hover:border-white/20 hover:bg-white/5 transition-all duration-300"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          See it in action
        </a>
      </div>

      <p
        class="text-xs text-text-muted mt-4 font-mono"
        style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.4s both"
      >
        Start free &mdash; no credit card required
      </p>
    </div>

    <!-- Right: Dashboard + Chat mockup -->
    <div
      class="relative"
      style="animation: fade-in-up 0.8s cubic-bezier(0.16,1,0.3,1) 0.4s both"
    >
      <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-wire-500/20 to-transparent"></div>
      <div class="relative rounded-2xl bg-surface border border-white/5 overflow-hidden glow-wire">
        <!-- Window titlebar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-surface-raised">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
          </div>
          <span class="ml-2 text-xs text-text-muted font-mono">wireclaw &mdash; research-bot</span>
        </div>

        <!-- Agent status bar -->
        <div class="px-5 py-3 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
              <span class="text-xs font-mono text-green-400">Running</span>
            </div>
            <span class="text-xs text-text-muted font-mono">12d 7h uptime</span>
          </div>
          <div class="flex items-center gap-3 text-xs font-mono text-text-muted">
            <span>8,471 msgs</span>
            <span>2,340 tools</span>
          </div>
        </div>

        <!-- Chat area -->
        <div class="p-5 space-y-4 min-h-[280px]">
          <!-- User message -->
          <div class="flex justify-end opacity-0" style="animation: fade-in-up 0.4s cubic-bezier(0.16,1,0.3,1) 1s both">
            <div class="max-w-[75%] px-4 py-2.5 rounded-2xl rounded-tr-sm bg-wire-500/20 border border-wire-500/10">
              <p class="text-sm text-text-primary">Find recent papers on RLHF</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-[10px] text-text-muted font-mono">via Telegram</span>
              </div>
            </div>
          </div>

          <!-- Agent thinking -->
          <div class="flex justify-start opacity-0" style="animation: fade-in-up 0.4s cubic-bezier(0.16,1,0.3,1) 1.6s both">
            <div class="max-w-[85%] px-4 py-2.5 rounded-2xl rounded-tl-sm bg-surface-raised border border-white/5">
              <div class="flex items-center gap-2 mb-2 text-[10px] font-mono">
                <span class="text-claw-400">web_search</span>
                <span class="text-text-muted">&middot;</span>
                <span class="text-claw-400">browser</span>
                <span class="text-text-muted">&middot;</span>
                <span class="text-claw-400">file_read</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed">
                Found 12 papers from last 30 days. Top result:
              </p>
              <div class="mt-2 px-3 py-2 rounded-lg bg-surface border border-white/5 font-mono text-[11px]">
                <div class="text-text-primary">"Direct Preference Optimization"</div>
                <div class="text-text-muted">Score: 94/100 &middot; Citations: 847</div>
              </div>
              <p class="text-[11px] text-text-muted mt-2 font-mono">Saved to memory &middot; 3.2s</p>
            </div>
          </div>

          <!-- Agent follow-up -->
          <div class="flex justify-start opacity-0" style="animation: fade-in-up 0.4s cubic-bezier(0.16,1,0.3,1) 2.2s both">
            <div class="max-w-[85%] px-4 py-2.5 rounded-2xl rounded-tl-sm bg-surface-raised border border-white/5">
              <p class="text-sm text-text-secondary leading-relaxed">
                Full analysis posted to <span class="text-wire-400">#research-updates</span> on Slack.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
