---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const docs = await getCollection("docs");

const grouped = docs.reduce(
  (acc, doc) => {
    const cat = doc.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(doc);
    return acc;
  },
  {} as Record<string, typeof docs>,
);

for (const cat of Object.keys(grouped)) {
  grouped[cat].sort((a, b) => a.data.order - b.data.order);
}

const categoryOrder = ["Getting Started", "Platform"];
const sortedCategories = Object.keys(grouped).sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});
---

<Layout
  title="Documentation — Wireclaw"
  description="Learn how to deploy and manage autonomous AI agents with Wireclaw."
>
  <Navbar />

  <main class="pt-24 pb-20 min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12">
        <h1 class="text-4xl font-display font-bold mb-4" data-animate>Documentation</h1>
        <p class="text-lg text-text-secondary max-w-2xl" data-animate data-delay="1">
          Everything you need to deploy, configure, and manage autonomous AI agents on Wireclaw.
        </p>
      </div>

      <div class="space-y-10">
        {sortedCategories.map((category, catIdx) => (
          <section data-animate data-delay={catIdx + 1}>
            <h2 class="text-xs font-mono text-text-muted uppercase tracking-widest mb-4">
              {category}
            </h2>
            <div class="grid gap-4 sm:grid-cols-2">
              {grouped[category].map((doc) => (
                <a
                  href={`/docs/${doc.id}`}
                  class="group block p-5 rounded-xl bg-surface-raised border border-white/5 hover:border-wire-500/20 transition-all duration-200"
                >
                  <h3 class="font-display font-semibold mb-1.5 group-hover:text-wire-400 transition-colors">
                    {doc.data.title}
                  </h3>
                  <p class="text-sm text-text-muted leading-relaxed">
                    {doc.data.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
