---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// TOC — H2 only
const toc = headings.filter((h) => h.depth === 2);

// Series metadata
const seriesLabels: Record<string, { label: string; color: string }> = {
  "build-this": { label: "Build This", color: "wire" },
  "under-the-hood": { label: "Under the Hood", color: "claw" },
  "agent-patterns": { label: "Agent Patterns", color: "wire" },
  "versus": { label: "Versus", color: "wire" },
  "toolbox": { label: "Toolbox", color: "wire" },
  "ship-log": { label: "Ship Log", color: "wire" },
};
const seriesInfo = post.data.series ? seriesLabels[post.data.series] : null;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const siteUrl = "https://wireclaw.ai";
---

<Layout
  title={`${post.data.title} — Wireclaw Blog`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image}
  canonicalUrl={`${siteUrl}/blog/${post.id}`}
  keywords={post.data.keywords}
  articleMeta={{
    publishedTime: post.data.date.toISOString(),
    author: post.data.author,
    section: seriesInfo?.label || "Blog",
    tags: post.data.tags,
  }}
>
  <Navbar />

  <main class="pt-24 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex gap-12 justify-center">
        <!-- Main content -->
        <article class="max-w-3xl w-full">
          <header class="mb-10">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              {seriesInfo && (
                <a
                  href={`/blog?series=${post.data.series}`}
                  class:list={[
                    "inline-flex items-center text-xs font-mono px-2.5 py-1 rounded-full border transition-colors",
                    seriesInfo.color === "claw"
                      ? "bg-claw-500/10 text-claw-400 border-claw-500/20 hover:bg-claw-500/15"
                      : "bg-wire-500/10 text-wire-400 border-wire-500/20 hover:bg-wire-500/15",
                  ]}
                >
                  {seriesInfo.label}
                </a>
              )}
              <time class="text-sm font-mono text-text-muted">
                {formatDate(post.data.date)}
              </time>
              <span class="text-text-muted">&middot;</span>
              <span class="text-sm text-text-muted">{post.data.author}</span>
              <span class="text-text-muted">&middot;</span>
              <span class="text-sm text-text-muted">{readingTime} min read</span>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-wire-500/10 text-wire-400">
                  {tag}
                </span>
              ))}
            </div>
          </header>

          <div class="prose-wireclaw">
            <Content />
          </div>

          <div class="mt-16 pt-8 border-t border-white/5">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-wire-400 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M11 17l-5-5m0 0l5-5m-5 5h12" />
              </svg>
              Back to blog
            </a>
          </div>
        </article>

        <!-- TOC sidebar -->
        {toc.length > 0 && (
          <aside class="hidden xl:block w-56 shrink-0">
            <nav class="sticky top-28">
              <div class="text-xs font-mono text-text-muted uppercase tracking-widest mb-3">
                On this page
              </div>
              <ul class="space-y-2 border-l border-white/5 pl-3">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-sm text-text-muted hover:text-text-primary transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </main>

  <Footer />

  <!-- Copy button for code blocks -->
  <script>
    document.querySelectorAll('.prose-wireclaw pre').forEach((pre) => {
      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (code) {
          await navigator.clipboard.writeText(code.innerText);
          button.textContent = 'Copied!';
          setTimeout(() => { button.textContent = 'Copy'; }, 2000);
        }
      });
      pre.appendChild(button);
    });
  </script>
</Layout>
