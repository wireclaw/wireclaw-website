---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import SeriesBadge from "../../components/SeriesBadge.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// TOC — H2 only
const toc = headings.filter((h) => h.depth === 2);

// OG image: custom or auto-generated
const ogImage = post.data.image || `/og/${post.id}.png`;

// Series label for article meta
const seriesLabelMap: Record<string, string> = {
  "build-this": "Build This",
  "under-the-hood": "Under the Hood",
  "agent-patterns": "Agent Patterns",
  "versus": "Versus",
  "toolbox": "Toolbox",
  "ship-log": "Ship Log",
};
const seriesLabel = post.data.series ? seriesLabelMap[post.data.series] : null;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const siteUrl = "https://wireclaw.ai";
---

<Layout
  title={`${post.data.title} — Wireclaw Blog`}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  canonicalUrl={`${siteUrl}/blog/${post.id}`}
  keywords={post.data.keywords}
  articleMeta={{
    publishedTime: post.data.date.toISOString(),
    author: post.data.author,
    section: seriesLabel || "Blog",
    tags: post.data.tags,
  }}
>
  <Navbar />

  <main class="pt-24 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex gap-12 justify-center">
        <!-- Main content -->
        <article class="max-w-3xl w-full">
          <header class="mb-10">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              {post.data.series && (
                <SeriesBadge series={post.data.series} linked />
              )}
              <time class="text-sm font-mono text-text-muted">
                {formatDate(post.data.date)}
              </time>
              <span class="text-text-muted">&middot;</span>
              <span class="text-sm text-text-muted">{post.data.author}</span>
              <span class="text-text-muted">&middot;</span>
              <span class="text-sm text-text-muted">{readingTime} min read</span>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-wire-500/10 text-wire-400">
                  {tag}
                </span>
              ))}
            </div>
          </header>

          <div class="prose-wireclaw">
            <Content />
          </div>

          <div class="mt-12">
            <NewsletterForm />
          </div>

          <div class="mt-8 pt-8 border-t border-white/5">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-wire-400 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M11 17l-5-5m0 0l5-5m-5 5h12" />
              </svg>
              Back to blog
            </a>
          </div>
        </article>

        <!-- TOC sidebar -->
        {toc.length > 0 && (
          <aside class="hidden xl:block w-56 shrink-0">
            <nav class="sticky top-28">
              <div class="text-xs font-mono text-text-muted uppercase tracking-widest mb-3">
                On this page
              </div>
              <ul class="space-y-2 border-l border-white/5 pl-3">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-sm text-text-muted hover:text-text-primary transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </main>

  <Footer />

  <!-- Copy button for code blocks -->
  <script>
    document.querySelectorAll('.prose-wireclaw pre').forEach((pre) => {
      const button = document.createElement('button');
      button.className = 'copy-btn';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (code) {
          await navigator.clipboard.writeText(code.innerText);
          button.textContent = 'Copied!';
          setTimeout(() => { button.textContent = 'Copy'; }, 2000);

          window.posthog?.capture('code_copied', {
            post_id: window.location.pathname.replace('/blog/', ''),
            language: code.className?.match(/language-(\w+)/)?.[1] || 'unknown',
          });
        }
      });
      pre.appendChild(button);
    });
  </script>

  <!-- Blog engagement tracking -->
  <script>
    const postId = window.location.pathname.replace('/blog/', '');
    const startTime = Date.now();
    const firedDepths = new Set<number>();

    // Scroll depth milestones
    const article = document.querySelector('article');
    if (article) {
      window.addEventListener('scroll', () => {
        const rect = article.getBoundingClientRect();
        const articleHeight = rect.height;
        const scrolled = window.scrollY - article.offsetTop + window.innerHeight;
        const pct = Math.min(100, Math.max(0, Math.round((scrolled / articleHeight) * 100)));

        for (const milestone of [25, 50, 75, 100]) {
          if (pct >= milestone && !firedDepths.has(milestone)) {
            firedDepths.add(milestone);
            window.posthog?.capture('blog_scroll_depth', {
              post_id: postId,
              depth: milestone,
            });
          }
        }
      }, { passive: true });
    }

    // Reading time on page leave
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        const seconds = Math.round((Date.now() - startTime) / 1000);
        window.posthog?.capture('blog_post_read', {
          post_id: postId,
          time_on_page_seconds: seconds,
          max_scroll_depth: Math.max(0, ...firedDepths),
        });
      }
    });
  </script>
</Layout>
