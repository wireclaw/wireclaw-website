---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  currentId?: string;
}

const { title, description, currentId } = Astro.props;

const docs = await getCollection("docs");

const grouped = docs.reduce(
  (acc, doc) => {
    const cat = doc.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(doc);
    return acc;
  },
  {} as Record<string, typeof docs>,
);

// Sort each category by order
for (const cat of Object.keys(grouped)) {
  grouped[cat].sort((a, b) => a.data.order - b.data.order);
}

// Define category display order
const categoryOrder = ["Getting Started", "Platform"];
const sortedCategories = Object.keys(grouped).sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});
---

<Layout title={`${title} — Wireclaw Docs`} description={description}>
  <Navbar />

  <div class="pt-16 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="hidden lg:block w-64 shrink-0 border-r border-white/5 bg-surface/50">
      <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-6">
        <a
          href="/docs"
          class="block text-xs font-mono text-text-muted uppercase tracking-widest mb-6 hover:text-text-secondary transition-colors"
        >
          Documentation
        </a>

        {sortedCategories.map((category) => (
          <div class="mb-6">
            <div class="text-xs font-mono text-text-muted uppercase tracking-widest mb-2">
              {category}
            </div>
            <ul class="space-y-1">
              {grouped[category].map((doc) => {
                const isActive = doc.id === currentId;
                return (
                  <li>
                    <a
                      href={`/docs/${doc.id}`}
                      class:list={[
                        "block text-sm py-1.5 px-3 rounded-md transition-colors",
                        isActive
                          ? "text-wire-400 bg-wire-500/10 border-l-2 border-wire-500 -ml-px"
                          : "text-text-secondary hover:text-text-primary hover:bg-white/5",
                      ]}
                    >
                      {doc.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Mobile sidebar toggle -->
    <div class="lg:hidden fixed bottom-6 left-6 z-40">
      <button
        id="docs-sidebar-toggle"
        class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-raised border border-white/10 text-sm text-text-secondary hover:text-text-primary shadow-lg transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h8M4 18h16" />
        </svg>
        Menu
      </button>
    </div>

    <!-- Mobile sidebar overlay -->
    <div
      id="docs-sidebar-overlay"
      class="hidden lg:hidden fixed inset-0 z-50 bg-navy-950/80 backdrop-blur-sm"
    >
      <aside class="w-72 h-full border-r border-white/5 bg-surface overflow-y-auto p-6">
        <div class="flex items-center justify-between mb-6">
          <span class="text-xs font-mono text-text-muted uppercase tracking-widest">
            Documentation
          </span>
          <button id="docs-sidebar-close" class="text-text-muted hover:text-text-primary transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        {sortedCategories.map((category) => (
          <div class="mb-6">
            <div class="text-xs font-mono text-text-muted uppercase tracking-widest mb-2">
              {category}
            </div>
            <ul class="space-y-1">
              {grouped[category].map((doc) => {
                const isActive = doc.id === currentId;
                return (
                  <li>
                    <a
                      href={`/docs/${doc.id}`}
                      class:list={[
                        "block text-sm py-1.5 px-3 rounded-md transition-colors",
                        isActive
                          ? "text-wire-400 bg-wire-500/10 border-l-2 border-wire-500 -ml-px"
                          : "text-text-secondary hover:text-text-primary hover:bg-white/5",
                      ]}
                    >
                      {doc.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </aside>
    </div>

    <!-- Content -->
    <main class="flex-1 min-w-0 px-6 py-12 lg:px-12">
      <div class="max-w-3xl mx-auto">
        <div class="prose-wireclaw">
          <slot />
        </div>
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<script>
  const toggle = document.getElementById("docs-sidebar-toggle");
  const overlay = document.getElementById("docs-sidebar-overlay");
  const close = document.getElementById("docs-sidebar-close");

  toggle?.addEventListener("click", () => overlay?.classList.remove("hidden"));
  close?.addEventListener("click", () => overlay?.classList.add("hidden"));
  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) overlay.classList.add("hidden");
  });
</script>
